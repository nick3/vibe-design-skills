{
  "name": "vibe-design-skills",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Validation tooling for the Vibe Design Skills suite.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:discovery": "node scripts/check-skills-cli.mjs",
    "check:source": "node scripts/check-skills-cli.mjs",
    "check:remote": "node scripts/check-skills-cli.mjs nick3/vibe-design-skills",
    "check": "bun run validate && bun run test && bun run check:discovery"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.7",
  "devDependencies": {
    "ajv": "8.20.0",
    "skills": "1.5.19",
    "yaml": "2.9.0"
  }
}
